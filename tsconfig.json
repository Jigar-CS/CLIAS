{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@clias/shared-types": ["packages/shared-types/src/index.ts"],
      "@clias/config": ["packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
